{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker LuaLaTeX build (fullstack)",
      "type": "process",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-v",
        "${workspaceFolder}:/work",
        "-w",
        "/work",
        "ehsancv/latex:latest",
        "lualatex",
        "-synctex=0",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-shell-escape",
        "-output-directory=pdf",
        "-aux-directory=build",
        "fullstack.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Docker latexmk LuaLaTeX build",
      "type": "process",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-v",
        "${workspaceFolder}:/work",
        "-w",
        "/work",
        "ehsancv/latex:latest",
        "latexmk",
        "-synctex=0",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-lualatex",
        "-shell-escape",
        "-outdir=pdf",
        "-auxdir=build",
        "fullstack.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build"
    },
    {
      "label": "Docker LuaLaTeX build (java-entry)",
