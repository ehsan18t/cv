{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker latexmk (all root tex)",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--rm", "cv-builder"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
