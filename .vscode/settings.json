{
  "editor.wordWrap": "on",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-lualatex",
      "command": "docker",
      "args": [
        "compose",
        "run",
        "--rm",
        "-e",
        "TARGET=%RELATIVE_DOC%.tex",
        "cv-builder"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "Latexmk (LuaLaTeX)",
      "tools": [
        "latexmk-lualatex"
      ]
    }
  ],
  "latex-workshop.latex.autoBuild.recipe": "Latexmk (LuaLaTeX)",
  "latex-workshop.latex.recipe.default": "Latexmk (LuaLaTeX)",
  "latex-workshop.docker.enabled": true,
  "latex-workshop.view.outline.enabled": false,
  "latex-workshop.docker.image.latex": "ehsancv/latex:latest",
  "latex-workshop.texcount.path": "docker",
  "latex-workshop.texcount.args": [
    "run",
    "--rm",
    "-v",
    "${workspaceFolder}:/work",
    "-w",
    "/work",
    "ehsancv/latex:latest",
    "texcount"
  ],
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/pdf",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": false,
  "latex-workshop.message.error.show": true,
  "latex-workshop.message.warning.show": false,
  "latex-workshop.intellisense.package.enabled": true,
  "cSpell.words": [
    "Dockerized",
    "Pino",
    "Valkey",
    "Vitest"
  ]
}
