% ehsancv.sty - Custom CV template helpers
% Author: Md. Ehsan Khan (maintained with assistance from GitHub Copilot)
% This package centralises layout, typographic choices, and helper macros for the CV.

\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{styles/ehsancv}[2025/10/10 v1.0 Custom CV template]

% ==============================
% Engine guard (LuaLaTeX / XeLaTeX required for fontspec)
% ==============================
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{ehsancv}{This template requires LuaLaTeX or XeLaTeX}{Switch to LuaLaTeX or XeLaTeX in your build recipe.}
\fi

% ==============================
% Core packages
% ==============================
\RequirePackage{geometry}
\RequirePackage{titlesec}
\RequirePackage{transparent-nometadata}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{enumitem}
\RequirePackage{fontawesome5}
\RequirePackage{svg}
\RequirePackage{amsmath}
\RequirePackage{microtype}
\RequirePackage{fontspec}
\RequirePackage{hyperref}
\RequirePackage{calc}
\RequirePackage{bookmark}
\RequirePackage{lastpage}
\RequirePackage{changepage}
\RequirePackage{paracol}
\RequirePackage{ifthen}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage{xparse}
\RequirePackage{pgfkeys}
\RequirePackage{etoolbox}

% ==============================
% Defaults and internal state
% ==============================
\def\cv@name{}
\def\cv@tagline{}
\def\cv@contacts{}
\def\cv@primarycolor{0,79,144}
\def\cv@linkcolor{0,51,102}
\def\cv@updated{\today}
\def\cv@footerlabel{Last updated:}
\def\cv@showupdated{true}
\def\cv@contactsep{\kern 0.25 cm\AND\kern 0.25 cm}
\def\cv@contactbreak{\\}
\def\cv@headerlinespread{1.5}
\def\cv@contactcolor{headerLinkColor}
\def\cv@namefontcmd{\fontsize{24 pt}{24 pt}\selectfont\bfseries}
\def\cv@taglinefontcmd{\normalsize\bfseries}
\def\cv@contactfontcmd{\normalsize}
\def\cv@namecolor{black}
\def\cv@taglinecolor{primaryColor}
\def\cv@showfooter{true}
\def\cv@showpage{true}
\def\cv@footercolor{gray}
\def\cv@footerfontcmd{\small\itshape}
\def\cv@pageformat{Page \thepage\ of \pageref*{LastPage}}
\def\cv@footerleftcmd{\cv@renderUpdated}
\def\cv@footerrightcmd{\cv@renderPage}
\def\cv@sectionformat{\needspace{4\baselineskip}\Large\bfseries\color{primaryColor}}
\def\cv@sectionpostformat{\vspace{2pt}\titlerule}
\def\cv@sectionleftspace{-1pt}
\def\cv@sectionbeforespace{0.3 cm}
\def\cv@sectionafterspace{0.2 cm}
\def\cv@fontname{lato}
\def\cv@fontoptions{}

% ==============================
% Helper keys for user configuration
% ==============================
\pgfkeys{/ehsancv/.is family,/ehsancv,
  name/.code={\def\cv@name{#1}},
  tagline/.code={\def\cv@tagline{#1}},
  contacts/.code={\def\cv@contacts{#1}},
  primarycolor/.code={\def\cv@primarycolor{#1}\definecolor{primaryColor}{RGB}{#1}\def\cv@taglinecolor{primaryColor}\hypersetup{linkcolor=primaryColor,urlcolor=primaryColor,citecolor=primaryColor}},
  linkcolor/.code={\def\cv@linkcolor{#1}\definecolor{headerLinkColor}{RGB}{#1}},
  lastupdated/.code={\def\cv@updated{#1}},
  updatedlabel/.code={\def\cv@footerlabel{#1}},
  showupdated/.code={\def\cv@showupdated{#1}},
  contactsep/.code={\def\cv@contactsep{#1}},
  contactbreak/.code={\def\cv@contactbreak{#1}},
  headerlinespread/.code={\def\cv@headerlinespread{#1}},
  contactcolor/.code={\def\cv@contactcolor{#1}},
  namefont/.code={\def\cv@namefontcmd{#1}},
  taglinefont/.code={\def\cv@taglinefontcmd{#1}},
  contactfont/.code={\def\cv@contactfontcmd{#1}},
  namecolor/.code={\def\cv@namecolor{#1}},
  taglinecolor/.code={\def\cv@taglinecolor{#1}},
  showfooter/.code={\def\cv@showfooter{#1}},
  showpage/.code={\def\cv@showpage{#1}},
  footercolor/.code={\def\cv@footercolor{#1}},
  footerfont/.code={\def\cv@footerfontcmd{#1}},
  footer-left/.code={\def\cv@footerleftcmd{#1}},
  footer-right/.code={\def\cv@footerrightcmd{#1}},
  pageformat/.code={\def\cv@pageformat{#1}},
  sectionformat/.code={\def\cv@sectionformat{#1}},
  sectionpost/.code={\def\cv@sectionpostformat{#1}},
  sectionleft/.code={\def\cv@sectionleftspace{#1}},
  sectionbefore/.code={\def\cv@sectionbeforespace{#1}},
  sectionafter/.code={\def\cv@sectionafterspace{#1}},
  font/.code={\def\cv@fontname{#1}\cv@applyfont},
  fontoptions/.code={\def\cv@fontoptions{#1}\cv@applyfont},
  pdftitle/.code={\hypersetup{pdftitle={#1}}},
  pdfauthor/.code={\hypersetup{pdfauthor={#1}}},
  pdfsubject/.code={\hypersetup{pdfsubject={#1}}},
  pdfkeywords/.code={\hypersetup{pdfkeywords={#1}}},
  urlcolor/.code={\hypersetup{urlcolor={#1}}}
}

% Default colors applied once
\definecolor{primaryColor}{RGB}{0,79,144}
\definecolor{headerLinkColor}{RGB}{0,51,102}

\hypersetup{
  colorlinks=true,
  linkcolor=primaryColor,
  urlcolor=primaryColor,
  citecolor=primaryColor
}

% ==============================
% Geometry & typography
% ==============================
\geometry{
  ignoreheadfoot,
  top=1.5 cm,
  bottom=1.5 cm,
  left=1.5 cm,
  right=1.5 cm,
  footskip=1.0 cm
}

\defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}

\newcommand{\cv@applyfont}{%
  \setmainfont[\cv@fontoptions]{\cv@fontname}%
  \setsansfont[\cv@fontoptions]{\cv@fontname}%
}

\cv@applyfont
\renewcommand*\familydefault{\sfdefault}

% ==============================
% Section styling and spacing
% ==============================
\AtBeginEnvironment{adjustwidth}{\partopsep0pt}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\setlength{\topskip}{0pt}
\setlength{\columnsep}{0cm}
\linespread{1.05}

\newcommand{\cv@applysectionstyle}{%
  \titleformat{\section}{\cv@sectionformat}{}{0pt}{}[\cv@sectionpostformat]%
  \titlespacing{\section}{\cv@sectionleftspace}{\cv@sectionbeforespace}{\cv@sectionafterspace}%
}

\renewcommand\labelitemi{{\color{primaryColor}\small\textbullet}}

% ==============================
% Custom environments
% ==============================
\newenvironment{highlights}{
  \begin{itemize}[
    topsep=0.10 cm,
    parsep=0.10 cm,
    partopsep=0pt,
    itemsep=0pt,
    leftmargin=0.4 cm + 10pt
  ]
}{
  \end{itemize}
}

\newenvironment{highlightsforbulletentries}{
  \begin{itemize}[
    topsep=0.10 cm,
    parsep=0.10 cm,
    partopsep=0pt,
    itemsep=0pt,
    leftmargin=10pt
  ]
}{
  \end{itemize}
}

\newenvironment{onecolentry}{
  \begin{adjustwidth}{0.2 cm + 0.00001 cm}{0.2 cm + 0.00001 cm}
}{
  \end{adjustwidth}
}

\newenvironment{twocolentry}[2][]{
  \onecolentry
  \def\secondColumn{#2}
  \setcolumnwidth{\fill, 4.5 cm}
  \begin{paracol}{2}
}{
  \switchcolumn \raggedleft \secondColumn
  \end{paracol}
  \endonecolentry
}

\newenvironment{header}{
  \setlength{\topsep}{0pt}\par\kern\topsep\centering\linespread{\cv@headerlinespread}
}{
  \par\kern\topsep
}

% ==============================
% Hyperref tweaks
% ==============================
\let\hrefWithoutArrow\href
\renewcommand{\href}[2]{\hrefWithoutArrow{#1}{\ifthenelse{\equal{#2}{}}{ }{#2 }\raisebox{.15ex}{\footnotesize \faExternalLink*}}}

% ==============================
% Contact helpers
% ==============================
\newsavebox\ANDbox
\sbox\ANDbox{}
\newcommand{\AND}{\unskip\cleaders\copy\ANDbox\hskip\wd\ANDbox\ignorespaces}

\newcommand{\cvcontactsep}{\cv@contactsep}
\newcommand{\cvcontactbreak}{\cv@contactbreak}

\NewDocumentCommand{\cvcontact}{m m o}{
  \mbox{\IfNoValueTF{#3}{%
      {\color{\cv@contactcolor}{\footnotesize #1}}\hspace*{0.13cm}#2
    }{%
      \hrefWithoutArrow{#3}{\color{\cv@contactcolor}{\footnotesize #1}\hspace*{0.13cm}\color{\cv@contactcolor}#2}%
    }}
}

\NewDocumentCommand{\cvsvgicon}{m m m}{%
  \expandafter\newcommand\csname#1\endcsname{\includesvg[height=#3]{#2}}%
}

% ==============================
% Header rendering
% ==============================
\newcommand{\cv@renderTagline}{%
  \ifdefempty{\cv@tagline}{}{
    \par
    \vspace{0.15 cm}%
    {\cv@taglinefontcmd\color{\cv@taglinecolor}\cv@tagline}%
  }%
}

\newcommand{\makecvheader}{%
  \begin{header}
    {\cv@namefontcmd\color{\cv@namecolor}\cv@name}
    \par
    \cv@renderTagline
    \ifdefempty{\cv@contacts}{}{
      \par
      \vspace{0.3 cm}
      {\cv@contactfontcmd \cv@contacts}
    }
  \end{header}
}

% ==============================
% Footer styling
% ==============================
\newcommand{\cv@renderUpdated}{%
  \ifdefstring{\cv@showupdated}{true}{%
    \ifblank{\cv@updated}{}{\cv@footerlabel\space\cv@updated}%
  }{}
}

\newcommand{\cv@renderPage}{%
  \ifdefstring{\cv@showpage}{true}{\cv@pageformat}{}
}

\newcommand{\cv@applyfootstyle}[1]{%
  \begingroup
    \cv@footerfontcmd
    \color{\cv@footercolor}%
    #1%
  \endgroup
}

\fancypagestyle{cvpagestyle}{%
  \fancyhf{}
  \ifdefstring{\cv@showfooter}{true}{%
    \fancyfoot[L]{\cv@applyfootstyle{\cv@footerleftcmd}}
    \fancyfoot[R]{\cv@applyfootstyle{\cv@footerrightcmd}}%
  }{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}
\pagestyle{cvpagestyle}

\AtBeginDocument{\cv@applysectionstyle}

% ==============================
% Public interface
% ==============================
\newcommand{\cvsetup}[1]{%
  \pgfkeys{/ehsancv,#1}%
}

\newcommand{\cvrefreshstyle}{\cv@applysectionstyle}

% Provide hook for overriding geometry late if desired
\newcommand{\cvsetgeometry}[1]{\geometry{#1}}


