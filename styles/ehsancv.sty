% ehsancv.sty - Custom CV template helpers
% Author: Md. Ehsan Khan (maintained with assistance from GitHub Copilot)
% This package centralises layout, typographic choices, and helper macros for the CV.

\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{styles/ehsancv}[2025/10/10 v1.0 Custom CV template]

% ==============================
% Engine guard (LuaLaTeX / XeLaTeX required for fontspec)
% ==============================
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{ehsancv}{This template requires LuaLaTeX or XeLaTeX}{Switch to LuaLaTeX or XeLaTeX in your build recipe.}
\fi

% ==============================
% Core packages
\newif\ifcv@hasheaderimage
\cv@hasheaderimagefalse
% ==============================
\RequirePackage{geometry}
\RequirePackage{titlesec}
\RequirePackage{transparent-nometadata}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage[dvipsnames]{xcolor}
\newlength{\cv@headertextwidthdim}
\RequirePackage{enumitem}
\RequirePackage{fontawesome5}
\RequirePackage{svg}
\RequirePackage{amsmath}
\RequirePackage{microtype}
\RequirePackage{fontspec}
\RequirePackage{hyperref}
\RequirePackage{calc}
\RequirePackage{bookmark}
\RequirePackage{lastpage}
\RequirePackage{changepage}
\RequirePackage{paracol}
\RequirePackage{ifthen}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage{xparse}
\RequirePackage{pgfkeys}
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\usetikzlibrary{calc}

% ==============================
% Defaults and internal state
% ==============================
\def\cv@name{}
\def\cv@tagline{}
\def\cv@contacts{}
\def\cv@primarycolor{0,79,144}
\def\cv@linkcolor{0,51,102}
\def\cv@updated{\today}
\def\cv@footerlabel{Last updated:}
\def\cv@showupdated{true}
\def\cv@contactsep{\kern 0.25 cm\AND\kern 0.25 cm}
\protected\def\cv@contactbreak{\\[\cv@headercontactslinegap]}
\def\cv@headerlinespread{1.5}
\def\cv@contactcolor{headerLinkColor}
\def\cv@namefontcmd{\fontsize{24 pt}{24 pt}\selectfont\bfseries}
\def\cv@taglinefontcmd{\normalsize\bfseries}
\def\cv@contactfontcmd{\normalsize}
\def\cv@headercontactsleading{1}
\newlength{\cv@headercontactsbaseline}
\newlength{\cv@headercontactslinegap}
\newif\ifcv@headercontactsbaselineset
\cv@headercontactsbaselinesetfalse
\def\cv@namecolor{black}
\def\cv@taglinecolor{primaryColor}
\newlength{\cv@nameaftergap}
\newlength{\cv@titleaftergap}
\newlength{\cv@headerinfoaftergap}
\def\cv@showfooter{true}
\def\cv@showpage{true}
\def\cv@footercolor{gray}
\def\cv@footerfontcmd{\small\itshape}
\def\cv@pageformat{Page \thepage\ of \pageref*{LastPage}}
\def\cv@footerleftcmd{\cv@renderUpdated}
\def\cv@footerrightcmd{\cv@renderPage}
\def\cv@sectionformat{\needspace{4\baselineskip}\Large\bfseries\color{primaryColor}}
\def\cv@sectionpostformat{\vspace{2pt}\titlerule}
\def\cv@sectionleftspace{-1pt}
\def\cv@sectionbeforespace{0.3 cm}
\def\cv@sectionafterspace{0.2 cm}
\def\cv@bodylinespread{1.05}
\def\cv@itemgap{0pt}
\def\cv@headerimage{}
\def\cv@headerlayout{center}
\def\cv@headerimageposition{page}
\def\cv@fontname{Calibri}
\def\cv@fontoptions{}

\newlength{\cv@headerimagesizedim}
\newlength{\cv@headerimageradius}
\newlength{\cv@headerimagepagegap}
\newlength{\cv@headerimagetopgap}
\newlength{\cv@headerimagerightgap}
\newlength{\cv@headerimagetextgap}
\newlength{\cv@headertopgap}
\newlength{\cv@headerbottomgap}
\newlength{\cv@headertopoffset}
\newlength{\cv@headergaptemp}
\setlength{\cv@headercontactsbaseline}{0pt}
\setlength{\cv@headercontactslinegap}{0pt}

\newcommand{\cv@setheadercontactsleading}[1]{%
  \edef\cv@tempa{#1}%
  \ifdim\cv@tempa pt>0pt
    \edef\cv@headercontactsleading{\cv@tempa}%
  \else
    \def\cv@headercontactsleading{1}% fallback to sensible default
  \fi
}

\setlength{\cv@headerimagesizedim}{3cm}
\setlength{\cv@headerimageradius}{0.5\cv@headerimagesizedim}
\setlength{\cv@headerimagepagegap}{0.15cm}
\setlength{\cv@headerimagetopgap}{\cv@headerimagepagegap}
\setlength{\cv@headerimagerightgap}{\cv@headerimagepagegap}
\setlength{\cv@headerimagetextgap}{0.15cm}
\setlength{\cv@headertopgap}{0pt}
\setlength{\cv@headerbottomgap}{0pt}
\setlength{\cv@headertopoffset}{0pt}
\setlength{\cv@headergaptemp}{0pt}
\setlength{\cv@nameaftergap}{0cm}
\setlength{\cv@titleaftergap}{0cm}
\setlength{\cv@headerinfoaftergap}{0cm}
\setlength{\cv@headertextwidthdim}{\textwidth}

% ==============================
% Helper keys for user configuration
% ==============================
\pgfkeys{/ehsancv/.is family,/ehsancv,
  name/.code={\def\cv@name{#1}},
  tagline/.code={\def\cv@tagline{#1}},
  contacts/.code={\def\cv@contacts{#1}},
  primarycolor/.code={\def\cv@primarycolor{#1}\definecolor{primaryColor}{RGB}{#1}\def\cv@taglinecolor{primaryColor}\hypersetup{linkcolor=primaryColor,urlcolor=primaryColor,citecolor=primaryColor}},
  linkcolor/.code={\def\cv@linkcolor{#1}\definecolor{headerLinkColor}{RGB}{#1}},
  lastupdated/.code={\def\cv@updated{#1}},
  updatedlabel/.code={\def\cv@footerlabel{#1}},
  showupdated/.code={\def\cv@showupdated{#1}},
  contactsep/.code={\def\cv@contactsep{#1}},
  contactbreak/.code={\def\cv@contactbreak{#1}},
  headercontactslinegap/.code={\setlength{\cv@headercontactslinegap}{#1}},
  headercontactsleading/.code={\cv@setheadercontactsleading{#1}},
  headercontactsbaseline/.code={\setlength{\cv@headercontactsbaseline}{#1}\cv@headercontactsbaselinesettrue},
  contactlinegap/.code={\setlength{\cv@headercontactslinegap}{#1}},% legacy alias
  contactlinespread/.code={\cv@setheadercontactsleading{#1}},% legacy alias
  contactbaselineskip/.code={\setlength{\cv@headercontactsbaseline}{#1}\cv@headercontactsbaselinesettrue},% legacy alias
  headerlinespread/.code={\def\cv@headerlinespread{#1}},
  contactcolor/.code={\def\cv@contactcolor{#1}},
  namefont/.code={\def\cv@namefontcmd{#1}},
  namesize/.code={\def\cv@namefontcmd{\fontsize{#1}{#1}\selectfont\bfseries}},
  nameaftergap/.code={\setlength{\cv@nameaftergap}{#1}},
  taglinefont/.code={\def\cv@taglinefontcmd{#1}},
  titlesize/.code={\def\cv@taglinefontcmd{\fontsize{#1}{#1}\selectfont\bfseries}},
  titleaftergap/.code={\setlength{\cv@titleaftergap}{#1}},
  contactfont/.code={\def\cv@contactfontcmd{#1}},
  namecolor/.code={\def\cv@namecolor{#1}},
  taglinecolor/.code={\def\cv@taglinecolor{#1}},
  showfooter/.code={\def\cv@showfooter{#1}},
  showpage/.code={\def\cv@showpage{#1}},
  bodylinespread/.code={\def\cv@bodylinespread{#1}\cv@applylinespread},
  footercolor/.code={\def\cv@footercolor{#1}},
  footerfont/.code={\def\cv@footerfontcmd{#1}},
  footer-left/.code={\def\cv@footerleftcmd{#1}},
  footer-right/.code={\def\cv@footerrightcmd{#1}},
  pageformat/.code={\def\cv@pageformat{#1}},
  sectionformat/.code={\def\cv@sectionformat{#1}},
  sectionpost/.code={\def\cv@sectionpostformat{#1}},
  sectionleft/.code={\def\cv@sectionleftspace{#1}},
  sectionbefore/.code={\def\cv@sectionbeforespace{#1}},
  sectionbeforespace/.code={\def\cv@sectionbeforespace{#1}},
  sectionafter/.code={\def\cv@sectionafterspace{#1}},
  itemgap/.code={\def\cv@itemgap{#1}},
  headerimage/.code={\def\cv@headerimage{#1}\ifstrempty{#1}{\cv@hasheaderimagefalse}{\cv@hasheaderimagetrue}},
  headerimagesize/.code={\setlength{\cv@headerimagesizedim}{#1}\setlength{\cv@headerimageradius}{0.5\cv@headerimagesizedim}},
  headerimagegap/.code={\setlength{\cv@headerimagepagegap}{#1}\setlength{\cv@headerimagetextgap}{#1}\setlength{\cv@headerimagetopgap}{#1}\setlength{\cv@headerimagerightgap}{#1}},
  headerimagepagegap/.code={\setlength{\cv@headerimagepagegap}{#1}\setlength{\cv@headerimagetopgap}{#1}\setlength{\cv@headerimagerightgap}{#1}},
  headerimagetopgap/.code={\setlength{\cv@headerimagetopgap}{#1}},
  headerimagerightgap/.code={\setlength{\cv@headerimagerightgap}{#1}},
  headerimagetextgap/.code={\setlength{\cv@headerimagetextgap}{#1}},
  headertopgap/.code={\setlength{\cv@headertopgap}{#1}},
  headerbottomgap/.code={\setlength{\cv@headerbottomgap}{#1}},
  headerinfoaftergap/.code={\setlength{\cv@headerinfoaftergap}{#1}},
  headertopoffset/.code={\setlength{\cv@headertopoffset}{#1}},
  headerlayout/.code={\def\cv@headerlayout{#1}},
  headerimageposition/.code={\def\cv@headerimageposition{#1}},
  font/.code={\def\cv@fontname{#1}\cv@applyfont},
  fontoptions/.code={\def\cv@fontoptions{#1}\cv@applyfont},
  pdftitle/.code={\hypersetup{pdftitle={#1}}},
  pdfauthor/.code={\hypersetup{pdfauthor={#1}}},
  pdfsubject/.code={\hypersetup{pdfsubject={#1}}},
  pdfkeywords/.code={\hypersetup{pdfkeywords={#1}}},
  urlcolor/.code={\hypersetup{urlcolor={#1}}}
}

% Default colors applied once
\definecolor{primaryColor}{RGB}{0,79,144}
\definecolor{headerLinkColor}{RGB}{0,51,102}

\hypersetup{
  colorlinks=true,
  linkcolor=primaryColor,
  urlcolor=primaryColor,
  citecolor=primaryColor
}

% ==============================
% Geometry & typography
% ==============================
\geometry{
  ignoreheadfoot,
  top=1.5 cm,
  bottom=1.5 cm,
  left=1.5 cm,
  right=1.5 cm,
  footskip=1.0 cm
}

\defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}

\newcommand{\cv@applyfont}{%
  \setmainfont[\cv@fontoptions]{\cv@fontname}%
  \setsansfont[\cv@fontoptions]{\cv@fontname}%
}

\cv@applyfont
\renewcommand*\familydefault{\sfdefault}

% ==============================
% Section styling and spacing
% ==============================
\AtBeginEnvironment{adjustwidth}{\partopsep0pt}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\setlength{\topskip}{0pt}
\setlength{\columnsep}{0cm}
\newcommand{\cv@applylinespread}{\linespread{\cv@bodylinespread}}
\cv@applylinespread

\newcommand{\cv@applysectionstyle}{%
  \titleformat{\section}{\cv@sectionformat}{}{0pt}{}[\cv@sectionpostformat]%
  \titlespacing{\section}{\cv@sectionleftspace}{\cv@sectionbeforespace}{\cv@sectionafterspace}%
}

\renewcommand\labelitemi{{\color{primaryColor}\small\textbullet}}

% ==============================
% Custom environments
% ==============================
\newenvironment{highlights}{
  \begin{itemize}[
    topsep=0.10 cm,
    parsep=0.10 cm,
    partopsep=0pt,
    itemsep=\cv@itemgap,
    leftmargin=0.4 cm + 10pt
  ]
}{
  \end{itemize}
}

\newenvironment{highlightsforbulletentries}{
  \begin{itemize}[
    topsep=0.10 cm,
    parsep=0.10 cm,
    partopsep=0pt,
    itemsep=\cv@itemgap,
    leftmargin=10pt
  ]
}{
  \end{itemize}
}

\newenvironment{onecolentry}{
  \begin{adjustwidth}{0.2 cm + 0.00001 cm}{0.2 cm + 0.00001 cm}
}{
  \end{adjustwidth}
}

\newenvironment{twocolentry}[2][]{
  \onecolentry
  \def\secondColumn{#2}
  \setcolumnwidth{\fill, 4.5 cm}
  \begin{paracol}{2}
}{
  \switchcolumn \raggedleft \secondColumn
  \end{paracol}
  \endonecolentry
}

\newenvironment{header}{%
  \par
  \vspace*{\dimexpr -\cv@headertopoffset + \cv@headertopgap\relax}% allow caller to lift header into the top margin
  \nointerlineskip
  \begingroup
  \linespread{\cv@headerlinespread}\selectfont
}{%
  \endgroup
  \par\vspace*{\cv@headerbottomgap}% configurable breathing room below header
}

% ==============================
% Hyperref tweaks
% ==============================
\let\hrefWithoutArrow\href
\renewcommand{\href}[2]{\hrefWithoutArrow{#1}{\ifthenelse{\equal{#2}{}}{ }{#2 }\raisebox{.15ex}{\footnotesize \faExternalLink*}}}

% ==============================
% Contact helpers
% ==============================
\newsavebox\ANDbox
\sbox\ANDbox{}
\newcommand{\AND}{\unskip\cleaders\copy\ANDbox\hskip\wd\ANDbox\ignorespaces}

\DeclareRobustCommand{\cvcontactsep}{\cv@contactsep}
\DeclareRobustCommand{\cvcontactbreak}{\cv@contactbreak}

\NewDocumentCommand{\cvcontact}{m m o}{
  \mbox{\IfNoValueTF{#3}{%
      {\color{\cv@contactcolor}{\footnotesize #1}}\hspace*{0.13cm}#2
    }{%
      \hrefWithoutArrow{#3}{\color{\cv@contactcolor}{\footnotesize #1}\hspace*{0.13cm}\color{\cv@contactcolor}#2}%
    }}
}

\NewDocumentCommand{\cvsvgicon}{m m m}{%
  \expandafter\newcommand\csname#1\endcsname{\includesvg[height=#3]{#2}}%
}

% ==============================
% Header rendering
% ==============================
\newcommand{\cv@renderTagline}{%
  {\cv@taglinefontcmd\color{\cv@taglinecolor}\cv@tagline}%
}

\newcommand{\cv@applyheadergap}[1]{%
  \par
  \setlength{\cv@headergaptemp}{#1}%
  \addtolength{\cv@headergaptemp}{-\baselineskip}%
  \vspace*{\cv@headergaptemp}%
  \noindent
}

\newcommand{\cv@applyheadergapafter}[1]{%
  \par
  \vspace*{#1}%
}

\newcommand{\cv@headerimagebox}{%
  \begin{tikzpicture}[baseline=(image.north)]
    \clip (0,0) circle[radius=\cv@headerimageradius];
    \node[inner sep=0pt] (image) {\includegraphics[width=\the\cv@headerimagesizedim]{\cv@headerimage}};
  \end{tikzpicture}
}

\newcommand{\cv@placeheaderimage}{%
  \ifcv@hasheaderimage
    \ifdefstring{\cv@headerimageposition}{page}{%
      \begin{tikzpicture}[remember picture,overlay]
  \coordinate (cvHeaderImageCenter) at ($(current page.north east) + (-\cv@headerimageradius - \cv@headerimagerightgap,-\cv@headerimageradius - \cv@headerimagetopgap)$);
        \begin{scope}
          \clip (cvHeaderImageCenter) circle[radius=\cv@headerimageradius];
          \node[anchor=center, inner sep=0] at (cvHeaderImageCenter){\includegraphics[width=\the\cv@headerimagesizedim]{\cv@headerimage}};
        \end{scope}
      \end{tikzpicture}%
    }{}
  \fi
}

\newcommand{\cv@computeheadertextwidth}{%
  \setlength{\cv@headertextwidthdim}{\textwidth}%
  \ifcv@hasheaderimage
  \addtolength{\cv@headertextwidthdim}{-\cv@headerimagesizedim}%
  \addtolength{\cv@headertextwidthdim}{-\cv@headerimagetextgap}%
  \fi
}

\newcommand{\cv@renderheadercontent}{%
  {\cv@namefontcmd\color{\cv@namecolor}\cv@name}%
  \ifstrempty{\cv@tagline}{}{%
    \cv@applyheadergap{\cv@nameaftergap}%
    \cv@renderTagline
  }%
  \ifstrempty{\cv@contacts}{}{%
    \ifstrempty{\cv@tagline}{\cv@applyheadergap{\cv@nameaftergap}}{\cv@applyheadergap{\cv@titleaftergap}}%
    {\begingroup
       \linespread{\cv@headercontactsleading}%
       \cv@contactfontcmd
       \selectfont
       \ifcv@headercontactsbaselineset
         \setlength{\baselineskip}{\cv@headercontactsbaseline}%
       \fi
       \cv@contacts
     \endgroup}%
    \cv@applyheadergapafter{\cv@headerinfoaftergap}%
  }%
}

\newcommand{\cv@rendercenterheader}{%
  \begin{header}
    \cv@placeheaderimage
    \noindent
    \ifdefstring{\cv@headerimageposition}{page}{%
      \cv@computeheadertextwidth
      \begin{minipage}[t]{\dimexpr\cv@headertextwidthdim\relax}
        \centering
        \cv@renderheadercontent
      \end{minipage}%
    }{
      \ifcv@hasheaderimage
  \begin{minipage}[t]{\dimexpr\textwidth - \cv@headerimagesizedim - \cv@headerimagetextgap\relax}
          \centering
          \cv@renderheadercontent
        \end{minipage}%
        \hfill
        \cv@headerimagebox
      \else
        \centering
        \cv@renderheadercontent
      \fi
    }
  \end{header}
}

\newcommand{\cv@renderleftheader}{%
  \begin{header}
    \cv@placeheaderimage
    \noindent
    \ifdefstring{\cv@headerimageposition}{page}{%
      \cv@computeheadertextwidth
      \begin{minipage}[t]{\dimexpr\cv@headertextwidthdim\relax}
        \raggedright
        \cv@renderheadercontent
      \end{minipage}%
    }{
      \ifcv@hasheaderimage
  \begin{minipage}[t]{\dimexpr\textwidth - \cv@headerimagesizedim - \cv@headerimagetextgap\relax}
          \raggedright
          \cv@renderheadercontent
        \end{minipage}%
        \hfill
        \cv@headerimagebox
      \else
        \begin{minipage}[t]{\textwidth}
          \raggedright
          \cv@renderheadercontent
        \end{minipage}%
      \fi
    }
  \end{header}
}

\newcommand{\makecvheader}{%
  \ifdefstring{\cv@headerlayout}{left}{\cv@renderleftheader}{\cv@rendercenterheader}%
}

% ==============================
% Footer styling
% ==============================
\newcommand{\cv@renderUpdated}{%
  \ifdefstring{\cv@showupdated}{true}{%
    \ifblank{\cv@updated}{}{\cv@footerlabel\space\cv@updated}%
  }{}
}

\newcommand{\cv@renderPage}{%
  \ifdefstring{\cv@showpage}{true}{\cv@pageformat}{}
}

\newcommand{\cv@applyfootstyle}[1]{%
  \begingroup
    \cv@footerfontcmd
    \color{\cv@footercolor}%
    #1%
  \endgroup
}

\fancypagestyle{cvpagestyle}{%
  \fancyhf{}
  \ifdefstring{\cv@showfooter}{true}{%
    \fancyfoot[L]{\cv@applyfootstyle{\cv@footerleftcmd}}
    \fancyfoot[R]{\cv@applyfootstyle{\cv@footerrightcmd}}%
  }{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}
\pagestyle{cvpagestyle}

\AtBeginDocument{\cv@applysectionstyle}

% ==============================
% Public interface
% ==============================
\newcommand{\cvsetup}[1]{%
  \pgfkeys{/ehsancv,#1}%
}

\newcommand{\cvrefreshstyle}{\cv@applysectionstyle}

% Provide hook for overriding geometry late if desired
\newcommand{\cvsetgeometry}[1]{\geometry{#1}}


